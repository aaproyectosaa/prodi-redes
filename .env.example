# ============ Frontend (Vite) ============
# Avisos push: la clave PÚBLICA VAPID (la misma que VAPID_PUBLIC_KEY de abajo). Se generan con: pnpm exec web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# URL pública
VITE_APP_URL=https://TU-DOMINIO.vercel.app
# En local, pnpm dev corre /api en el mismo 8080. Con esto, en cambio, manda /api a otro servidor (p. ej. la app publicada).
# VITE_API_PROXY=
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Opcional: link al instalador .apk de Android (ver docs/APP.md)
VITE_APK_URL=

# ============ Backend (Vercel → Settings → Environment Variables) ============
# Base de datos y login (v12: Postgres en Neon, sin Firebase)
# DATABASE_URL=postgresql://…neon.tech/neondb?sslmode=require     Neon → Connection string (la "pooled")
# AUTH_SECRET=                                     texto largo al azar (mín. 32): firma las sesiones. Si cambia, todos vuelven a entrar.
# INVITATION_CODE=                                 código para registrarse solo (si falta, el registro está cerrado)
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=            avisos push (pnpm exec web-push generate-vapid-keys)
# VAPID_SUBJECT=mailto:hola@somosprodi.com
# Solo para pasar los usuarios desde Firebase con su misma contraseña (Firebase → Authentication → Users → ⋮ → Password hash parameters):
# FIREBASE_HASH_SIGNER_KEY=  FIREBASE_HASH_SALT_SEPARATOR=  FIREBASE_HASH_ROUNDS=8  FIREBASE_HASH_MEM_COST=14
# Usuarios traídos de PostGo (otro proyecto de Firebase): FIREBASE_HASH_POSTGO_SIGNER_KEY=  FIREBASE_HASH_POSTGO_SALT_SEPARATOR=  (ROUNDS/MEM_COST igual)

# Ya existentes
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# OAUTH_STATE_SECRET=
# FIREBASE_SERVICE_ACCOUNT_BASE64=               solo para la migración desde Firebase (pnpm migrar:firebase); después se puede borrar

# Nuevas (Prodi Redes)
# APP_URL=https://TU-DOMINIO.vercel.app          URL pública para links de mails, push y Mercado Pago
# VITE_CHAT_URL=https://prodi-chat.vercel.app     Prodi Chat en su propia dirección: los avisos del chat van solo a esa app (agregar el dominio en Vercel)
# GEMINI_API_KEY=                                 Google AI Studio → API key (copys y piezas con IA)
# GEMINI_TEXT_MODEL=gemini-2.5-flash              opcional
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image       opcional
# MP_ACCESS_TOKEN=APP_USR-...                      Mercado Pago → Tus integraciones → Credenciales de producción
# MP_WEBHOOK_SECRET=                               Mercado Pago → Webhooks → clave secreta (valida la firma)
# RESEND_API_KEY=re_...                            resend.com (informes, boletas y avisos por correo)
# INFORME_FROM=Prodi <informes@somosprodi.com>     dominio verificado en Resend
# INFORME_REPLY_TO=hola@somosprodi.com             opcional
# CRON_SECRET=                                     cualquier texto largo al azar (protege los crons)
# APROBACION_SECRET=                               texto largo al azar: firma los links de aprobación del cliente
#                                                  (si falta, usa OAUTH_STATE_SECRET)
# META_ACCESS_TOKEN=                               token de usuario del sistema con ads_read (resultados automáticos, ver docs/META.md)
# META_APP_SECRET=                                 opcional: firma las llamadas a Meta (appsecret_proof)
# META_GRAPH_VERSION=v23.0                         opcional

# ── Factura electrónica (ARCA) ── ver docs/DESPLIEGUE.md → "Factura electrónica"
# ARCA_CUIT=                                       CUIT del emisor, sin guiones
# ARCA_CERT=                                       certificado (.crt) en base64 en una línea (o el PEM con \n)
# ARCA_KEY=                                        clave privada (.key) en base64 en una línea (o el PEM con \n)
# ARCA_PUNTO_VENTA=                                punto de venta "Web Services" (en homologación sirve cualquiera, p. ej. 1)
# ARCA_CONDICION=responsable_inscripto             o monotributo (factura C)
# ARCA_PRODUCCION=                                 "true" para facturar de verdad; vacío = homologación (prueba)
