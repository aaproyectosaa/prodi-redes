{
  "rewrites": [
    {
      "source": "/chat-app",
      "destination": "/chat-app.html"
    },
    {
      "source": "/chat-app/:path*",
      "destination": "/chat-app.html"
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "prodi-chat.vercel.app"
        }
      ],
      "destination": "/chat-app.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/avisos.ts": {
      "memory": 1024
    },
    "api/auth/[accion].ts": {
      "memory": 1024
    },
    "api/db/[accion].ts": {
      "memory": 1024
    },
    "api/drive/[accion].ts": {
      "memory": 1024
    },
    "api/in-app-notifications/delete.ts": {
      "memory": 1024
    },
    "api/pagos/[accion].ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/publico/[accion].ts": {
      "memory": 1024
    },
    "api/software/[accion].ts": {
      "memory": 1024
    },
    "api/usuarios/[accion].ts": {
      "memory": 1024
    },
    "api/web/[accion].ts": {
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/informes/cron",
      "schedule": "0 12 1 * *"
    },
    {
      "path": "/api/informes/diario",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/software/cron-sync",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
